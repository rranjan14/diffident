@@ -0,0 +1,96 @@
+"""Builds the content-accessible project list (the set of projects a user can access)."""
+
+from uuid import UUID
+
+from lb.db.models import Project, ProjectUserState, TeamMembership
+from lb.features.projects.project_access_service import (
+    ProjectAccess,
+    project_access_service,
+)
+from lb.features.projects.projects_schemas import (
+    ProjectCapabilities,
+    ProjectResource,
+)
+
+
+def resource_from_access(access: ProjectAccess, starred: bool) -> ProjectResource:
+    return ProjectResource(
+        id=access.project.id,
+        name=access.project.name,
+        instructions=access.project.instructions,
+        ownership_scope=access.ownership_scope.value,
+        visibility=access.project.visibility,
+        effective_role=access.role.value,
+        access_source=access.access_source.value,
+        capabilities=ProjectCapabilities(
+            can_view_content=True,
+            can_edit_content=access.can_edit_content,
+            can_manage_members=access.can_manage_members,
+            can_change_visibility=access.can_change_visibility,
+            can_delete=access.can_delete,
+            can_publish_own_snapshots=True,
+        ),
+        starred=starred,
+        limit_chat_context_to_project=access.project.limit_chat_context_to_project,
+        version=access.project.version,
+        created_at=access.project.created_at,
+        updated_at=access.project.updated_at,
+    )
+
+
+async def get_resource(requester_id: int, project_id: UUID) -> ProjectResource | None:
+    access = await project_access_service.resolve_content_access(requester_id, project_id)
+    if access is None:
+        return None
+    starred_by_id = await resolve_starred_bulk(requester_id, [access.project])
+    return resource_from_access(access, starred_by_id.get(access.project.id, False))
+
+
+async def list_projects(requester_id: int) -> list[ProjectResource]:
+    candidate_ids = await _candidate_project_ids(requester_id)
+    if not candidate_ids:
+        return []
+
+    access_by_id = await project_access_service.resolve_content_access_bulk(requester_id, candidate_ids)
+    if not access_by_id:
+        return []
+
+    starred_by_id = await resolve_starred_bulk(requester_id, [a.project for a in access_by_id.values()])
+
+    return [
+        resource_from_access(access, starred_by_id.get(access.project.id, False)) for access in access_by_id.values()
+    ]
+
+
+async def resolve_starred_bulk(requester_id: int, projects: list[Project]) -> dict[UUID, bool]:
+    """Batched starred resolution: ProjectUserState first, else legacy Project.starred for owners."""
+    project_ids = [p.id for p in projects]
+    starred_from_state: dict[UUID, bool] = {}
+    if project_ids:
+        async for pid, starred in ProjectUserState.objects.filter(
+            project_id__in=project_ids, user_id=requester_id
+        ).values_list("project_id", "starred"):
+            starred_from_state[pid] = starred
+
+    result: dict[UUID, bool] = {}
+    for project in projects:
+        if project.id in starred_from_state:
+            result[project.id] = starred_from_state[project.id]
+        elif project.user_id == requester_id:
+            result[project.id] = project.starred
+        else:
+            result[project.id] = False
+    return result
+
+
+async def _candidate_project_ids(requester_id: int) -> list[UUID]:
+    active_team_ids = [
+        tid
+        async for tid in TeamMembership.objects.filter(
+            user_id=requester_id, status=TeamMembership.Status.ACTIVE
+        ).values_list("team_id", flat=True)
+    ]
+    personal = Project.objects.filter(owner_user_id=requester_id, deleted_at__isnull=True)
+    team_owned = Project.objects.filter(owner_team_id__in=active_team_ids, deleted_at__isnull=True)
+    explicit = Project.objects.filter(memberships__user_id=requester_id, deleted_at__isnull=True)
+    return [pid async for pid in (personal | team_owned | explicit).values_list("id", flat=True).distinct()]
