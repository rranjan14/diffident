@@ -0,0 +1,178 @@
+"""REST project list: GET /projects, version conflicts, user-state."""
+
+import os
+import uuid
+
+import pytest
+import pytest_asyncio
+from fastapi.testclient import TestClient
+
+from lb.db.models import AppUser, Project, ProjectUserState
+from lb.features.user.user_router import generate_personal_access_token
+from tests.testing_utils import create_testing_app
+
+app = create_testing_app()
+
+
+@pytest.fixture(autouse=True)
+def setup_test_env():
+    os.environ["PERSONAL_TOKEN_SECRET"] = "test_secret_key"
+    yield
+    os.environ.pop("PERSONAL_TOKEN_SECRET", None)
+
+
+@pytest.fixture
+def client():
+    return TestClient(app)
+
+
+@pytest_asyncio.fixture
+async def list_user():
+    user = AppUser(email="list@example.com", token="list_tok", sub="list_sub")
+    await user.asave()
+    yield user
+    await ProjectUserState.objects.filter(user=user).adelete()
+    await Project.objects.filter(owner_user=user).adelete()
+    await user.adelete()
+
+
+@pytest_asyncio.fixture
+async def other_user():
+    user = AppUser(email="other@example.com", token="other_tok", sub="other_sub")
+    await user.asave()
+    yield user
+    await Project.objects.filter(owner_user=user).adelete()
+    await user.adelete()
+
+
+def _auth_headers(user: AppUser) -> dict[str, str]:
+    token = generate_personal_access_token(email=user.email, sub=str(user.sub))
+    return {"Authorization": f"Bearer {token}"}
+
+
+async def _make_personal_project(owner: AppUser, name: str = "My Project") -> Project:
+    return await Project.objects.acreate(
+        user=owner,
+        name=name,
+        agent_slug=name.lower().replace(" ", "-"),
+        sync_id=1,
+    )
+
+
+# ── Project list ──────────────────────────────────────────────────────
+
+
+@pytest.mark.asyncio
+async def test_list_returns_personal_projects(client, list_user):
+    project = await _make_personal_project(list_user, "Roadmap")
+
+    response = client.get("/projects", headers=_auth_headers(list_user))
+    assert response.status_code == 200, response.text
+    body = response.json()
+    assert len(body["projects"]) == 1
+    res = body["projects"][0]
+    assert res["id"] == str(project.id)
+    assert res["name"] == "Roadmap"
+    assert res["ownershipScope"] == "personal"
+    assert res["visibility"] == "private"
+    assert res["effectiveRole"] == "editor"
+    assert res["accessSource"] == "owner"
+    assert res["capabilities"]["canEditContent"] is True
+    assert res["capabilities"]["canDelete"] is True
+    assert res["capabilities"]["canViewContent"] is True
+    assert res["version"] == 1
+
+
+@pytest.mark.asyncio
+async def test_list_excludes_other_users_projects(client, list_user, other_user):
+    await _make_personal_project(list_user, "Mine")
+    await _make_personal_project(other_user, "Theirs")
+
+    response = client.get("/projects", headers=_auth_headers(list_user))
+    assert response.status_code == 200
+    ids = [p["id"] for p in response.json()["projects"]]
+    assert len(ids) == 1
+
+
+@pytest.mark.asyncio
+async def test_get_single_project_returns_resource(client, list_user):
+    project = await _make_personal_project(list_user, "Single")
+
+    response = client.get(f"/projects/{project.id}", headers=_auth_headers(list_user))
+    assert response.status_code == 200, response.text
+    assert response.json()["id"] == str(project.id)
+    assert response.json()["ownershipScope"] == "personal"
+
+
+@pytest.mark.asyncio
+async def test_get_single_project_404_for_nonexistent(client, list_user):
+    response = client.get(f"/projects/{uuid.uuid4()}", headers=_auth_headers(list_user))
+    assert response.status_code == 404
+
+
+@pytest.mark.asyncio
+async def test_patch_with_stale_expected_version_returns_409(client, list_user):
+    project = await _make_personal_project(list_user, "Conflicted")
+    stale = project.version
+
+    ok = client.patch(
+        f"/projects/{project.id}",
+        json={"name": "Updated"},
+        headers={**_auth_headers(list_user), "x-expected-version": str(stale)},
+    )
+    assert ok.status_code == 200
+
+    conflict = client.patch(
+        f"/projects/{project.id}",
+        json={"name": "Stale"},
+        headers={**_auth_headers(list_user), "x-expected-version": str(stale)},
+    )
+    assert conflict.status_code == 409
+
+
+@pytest.mark.asyncio
+async def test_patch_without_expected_version_succeeds(client, list_user):
+    project = await _make_personal_project(list_user, "No Guard")
+
+    response = client.patch(
+        f"/projects/{project.id}",
+        json={"name": "Renamed"},
+        headers=_auth_headers(list_user),
+    )
+    assert response.status_code == 200
+    assert response.json()["name"] == "Renamed"
+
+
+# ── User state ────────────────────────────────────────────────────────
+
+
+@pytest.mark.asyncio
+async def test_put_user_state_stars_project(client, list_user):
+    project = await _make_personal_project(list_user, "Starable")
+
+    response = client.put(
+        f"/projects/{project.id}/user-state",
+        json={"starred": True},
+        headers=_auth_headers(list_user),
+    )
+    assert response.status_code == 200, response.text
+
+    state = await ProjectUserState.objects.aget(project_id=project.id, user_id=list_user.id)
+    assert state.starred is True
+
+    # Project list reflects the starred state.
+    project_list = client.get("/projects", headers=_auth_headers(list_user))
+    res = [p for p in project_list.json()["projects"] if p["id"] == str(project.id)][0]
+    assert res["starred"] is True
+
+
+@pytest.mark.asyncio
+async def test_put_user_state_404_for_inaccessible(client, list_user, other_user):
+    project = await _make_personal_project(other_user, "Private")
+
+    response = client.put(
+        f"/projects/{project.id}/user-state",
+        json={"starred": True},
+        headers=_auth_headers(list_user),
+    )
+    assert response.status_code == 404
