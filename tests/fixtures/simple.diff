+      projects: [resource],
+    });
+
+    await store.refreshProjects();
+
+    expect(store.getById('p-cat-1')).toBeDefined();
+    expect(store.getById('p-cat-1')!.name).toBe('From REST');
+    expect(store.getById('p-cat-1')!.ownershipScope).toBe('personal');
+    expect(store.getById('p-cat-1')!.version).toBe(1);
+  });
+
+  it('removes projects absent from the authoritative response', async () => {
+    const existing = createListProject({ id: 'p-old', name: 'Old' });
+    vi.spyOn(sdk.apiClient, 'fetch').mockResolvedValueOnce({ projects: [] });
+    store.add({ ...existing, syncId: 0 });
+    expect(store.getById('p-old')).toBeDefined();
+
+    await store.refreshProjects();
+
+    expect(store.getById('p-old')).toBeUndefined();
+  });
+
+  it('surfaces fetch failures and preserves cached projects', async () => {
+    const resource = createListProject({ id: 'p-fail', name: 'Survives' });
+    store.add({ ...resource, syncId: 0 });
+
+    vi.spyOn(sdk.apiClient, 'fetch').mockRejectedValueOnce(
+      new Error('connection refused')
+    );
+
+    // The error must be surfaced, not silently swallowed.
