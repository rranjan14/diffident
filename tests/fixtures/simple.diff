+    // Make the removal fail AFTER the set succeeds — upsert must still be applied.
+    vi.spyOn(sdk.storage, 'bulkRemove').mockRejectedValueOnce(
+      new Error('storage corruption')
+    );
+
+    vi.spyOn(sdk.apiClient, 'fetch').mockResolvedValueOnce({
+      projects: [resource],
+    });
+
+    await expect(store.refreshProjects()).rejects.toThrow('storage corruption');
+    // The new project was staged (upsert happened first).
+    expect(bulkSetSpy).toHaveBeenCalled();
+    expect(store.getById('p-new')).toBeDefined();
+  });
+});
